# Local development and Vercel production environment-variable template.
# Generate an admin token: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Generate an encryption key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_TOKEN=replace-with-a-random-32-byte-token
LEADS_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
NEXT_PUBLIC_META_PIXEL_ID=replace-with-your-meta-pixel-id
PORT=3000
HOST=127.0.0.1
LEADS_FILE=./data/leads.json
